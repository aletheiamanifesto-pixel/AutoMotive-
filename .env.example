# Copia in .env.local. Tutto opzionale in sviluppo:
# senza Supabase l'app usa i dati locali, senza Stripe il checkout è disattivato.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server: webhook e job. MAI esporla al browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (usa le chiavi di test in sviluppo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXPLORER=
STRIPE_PRICE_ENGINEER=
STRIPE_PRICE_MASTER=
